# PostgreSQL connection string (required)
# Must start with postgresql:// or postgres://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flashnote_dev

# Sentry DSN for error monitoring (optional in development)
# Get this from: https://flashnote.sentry.io/settings/projects/flashnote-web/keys/
# NEXT_PUBLIC_SENTRY_DSN=

# Sentry auth token for source map uploads (CI/CD only)
# Get this from: https://flashnote.sentry.io/settings/auth-tokens/
# SENTRY_AUTH_TOKEN=

# Stripe publishable key (for client-side)
# Get from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Stripe price IDs (for checkout integration)
# Get from: https://dashboard.stripe.com/test/products
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_ANNUAL=price_xxx

# --- LLM Provider Configuration ---

# Which LLM provider to use: 'gemini' (default) or 'claude'
# Claude is dev/test only — no Anthropic BAA for production
# LLM_PROVIDER=gemini

# Google Gemini (required when LLM_PROVIDER=gemini and USE_MOCK_AI is not true)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_TOKENS=4000
# GEMINI_TEMPERATURE=0.2
# GEMINI_TIMEOUT_MS=30000

# Vertex AI ADC — set to true on Cloud Run (uses service account, no API key needed)
# GEMINI_USE_ADC=false
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic Claude (required when LLM_PROVIDER=claude)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=2000
# ANTHROPIC_TEMPERATURE=0.2
# ANTHROPIC_TIMEOUT_MS=30000

# Set to true to use mock AI responses (avoids API calls during development)
# USE_MOCK_AI=false

# --- Upstash Redis (Rate Limiting) ---
# Optional in dev/test — rate limiting is skipped without it
# Required in production
# Get from: https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx

# --- Email (Resend) ---
# Optional in dev/test — emails logged to console if not set
# Get your API key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM_NAME=FlashNote
# EMAIL_FROM_ADDRESS=noreply@flashnote.co

# --- App URLs ---
# WEB_URL=http://localhost:3000

# --- Registration ---
# Controls who can sign up: 'open' (anyone), 'invite' (invite code required), 'closed' (nobody)
# REGISTRATION_MODE=open
