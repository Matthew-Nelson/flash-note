{
  "name": "@flashnote/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FlashNote Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --import @sentry/node/preload src/index.ts",
    "dev:test": "NODE_ENV=test tsx watch --import @sentry/node/preload src/index.ts",
    "build": "tsc",
    "start": "node --import @sentry/node/preload dist/index.js",
    "test": "NODE_ENV=production vitest --run",
    "test:watch": "NODE_ENV=production vitest",
    "test:coverage": "NODE_ENV=production vitest --run --coverage",
    "test:ci": "NODE_ENV=production vitest --run --coverage --reporter=verbose",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "NODE_ENV=test tsx src/db/migrate.ts",
    "db:seed:test": "tsx src/db/seed-test.ts",
    "test:setup": "pnpm db:migrate:test && pnpm db:seed:test",
    "clean": "rm -rf dist coverage",
    "stripe:listen": "stripe listen --forward-to localhost:4000/billing/webhook"
  },
  "dependencies": {
    "@sentry/node": "^10.38.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.18.0",
    "resend": "^6.9.1",
    "stripe": "^20.3.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.5",
    "@types/pg": "^8.10.9",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
