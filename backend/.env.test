# Test environment configuration
# This file is loaded when NODE_ENV=test
# Safe to commit - contains no secrets (uses fake/test values)

NODE_ENV=test

# Test database (local)
DATABASE_URL=postgres://localhost/flashnote_test

# Auth secrets (test-only, not real secrets)
JWT_SECRET=test-jwt-secret-minimum-32-characters-long-for-testing
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters-long-testing
CSRF_SECRET=test-csrf-secret-minimum-32-characters-long-for-testing

# LLM - use mock for tests to avoid API costs
USE_MOCK_AI=true
LLM_PROVIDER=gemini
GEMINI_API_KEY=fake-key-for-testing

# Stripe test mode
STRIPE_SECRET_KEY=sk_test_fake_key_for_testing
STRIPE_WEBHOOK_SECRET=whsec_test_fake_secret_for_testing

# URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# CORS - permissive for testing
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
