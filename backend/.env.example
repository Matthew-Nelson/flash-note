# Server
NODE_ENV=development
PORT=4000

# Sentry Error Monitoring (optional in dev, recommended for production)
# Get your DSN from: https://flashnote.sentry.io/settings/projects/flashnote-backend/keys/
# SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flashnote

# Authentication
JWT_SECRET=your-256-bit-secret-here-change-in-production
JWT_REFRESH_SECRET=another-256-bit-secret-here-change-in-production
CSRF_SECRET=csrf-256-bit-secret-here-change-in-production

# LLM Provider Selection
# Choose which LLM provider to use: 'gemini' (default) or 'claude'
LLM_PROVIDER=gemini

# Google Gemini AI (required when LLM_PROVIDER=gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2000
GEMINI_TEMPERATURE=0.7
GEMINI_TIMEOUT_MS=30000

# Anthropic Claude (required when LLM_PROVIDER=claude)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_MAX_TOKENS=2000
# ANTHROPIC_TEMPERATURE=0.7
# ANTHROPIC_TIMEOUT_MS=30000

# Development - set to true to use mock AI responses (avoids API calls)
USE_MOCK_AI=true

# Stripe
# Get test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_xxx

# Email (Resend) - Optional for local dev (emails logged to console if not set)
# Get your API key at https://resend.com (free tier: 3,000 emails/month)
# RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@flashnote.app
EMAIL_FROM_NAME=FlashNote
EMAIL_VERIFICATION_TOKEN_EXPIRY_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# CORS Configuration
# Comma-separated list of allowed origins
# Include your web app URL, dev servers, and Chrome extension ID
# Example for production: https://flashnote.co,chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# For production HIPAA compliance (Vertex AI)
# GCP_PROJECT_ID=your-project-id

# Silence Promotions
DOTENV_CONFIG_QUIET=true